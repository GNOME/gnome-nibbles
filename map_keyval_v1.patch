+
+_CONFIGINCLUDE(gdkmmconfig.h)
+
+#include <gdk/gdk.h>
+
+_DEFS(gdkmm,gdk)
+
+namespace Gdk
+{
+/** Describes a hardware key that can be mapped to a key value.
+ *
+ * @newin{4,24}
+ */
+class GDKMM_API KeymapKey
+{
+  _CLASS_GENERIC(KeymapKey, GdkKeymapKey)
+public:
+  KeymapKey();
+  KeymapKey(guint keycode, int group, int level);
+  explicit KeymapKey(const GdkKeymapKey* keymap_key); // always takes a copy
+
+  /** The hardware keycode.
+   * This is an identifying number for a physical key.
+   */
+  _MEMBER_GET(keycode, keycode, guint, guint)
+  _MEMBER_SET(keycode, keycode, guint, guint)
+
+  /** Indicates movement in a horizontal direction.
+   * Usually groups are used for two different languages. In group 0, a key might
+   * have two English characters, and in group 1 it might have two Hebrew characters.
+   * The Hebrew characters will be printed on the key next to the English characters.
+   */
+  _MEMBER_GET(group, group, int, int)
+  _MEMBER_SET(group, group, int, int)
+
+  /** Indicates which symbol on the key will be used, in a vertical direction.
+   * So on a standard US keyboard, the key with the number “1” on it also has the
+   * exclamation point ("!") character on it. The level indicates whether to use
+   * the “1” or the “!” symbol. The letter keys are considered to have a lowercase
+   * letter at level 0, and an uppercase letter at level 1, though only the
+   * uppercase letter is printed.
+   */
+  _MEMBER_GET(level, level, int, int)
+  _MEMBER_SET(level, level, int, int)
+
+  /// Provides access to the underlying C object.
+  GdkKeymapKey*       gobj()       { return &gobject_; }
+  /// Provides access to the underlying C object.
+  const GdkKeymapKey* gobj() const { return &gobject_; }
+
+protected:
+  GdkKeymapKey gobject_;
+};
+
+} // namespace Gdk
