+
+Since: 2.90
+
+</description>
+<parameters>
+<parameter name="strv_pointer">
+<parameter_description> a pointer to either
+a `NULL`-terminated string array or `NULL`
+</parameter_description>
+</parameter>
+<parameter name="new_strv">
+<parameter_description> a `NULL`-terminated string array to
+assign to @strv_pointer
+</parameter_description>
+</parameter>
+</parameters>
+<return> true if the value of @strv_pointer changed, false otherwise
+
+</return>
+</function>
