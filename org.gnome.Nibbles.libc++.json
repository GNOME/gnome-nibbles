{
	"app-id": "org.gnome.Nibbles.libcxx",
	"runtime": "org.gnome.Platform",
	"runtime-version": "master",
	"sdk": "org.gnome.Sdk",
	"command": "gnome-nibbles",
	"build-options":
	{
		"env":
		{
		    "CC": "clang",
		    "CXX": "clang++"
		}
	},
	"finish-args":
	[
		/* X11 + XShm access */
		"--share=ipc", "--socket=fallback-x11",
		/* Wayland access */
		"--socket=wayland",
		/* Sound! */
		"--socket=pulseaudio",
		/* OpenGL access */
		"--device=dri"
	],
	"cleanup":
	[
		"/include",
		"/lib/pkgconfig",
		"/man",
		"/share/doc",
		"/share/gtk-doc",
		"/share/man",
		"/share/pkgconfig",
		"*.la",
		"*.a"
	],
	"modules":
	[
		{
			"name": "mold",
			"buildsystem": "cmake",
			"builddir": true,
			"build-options":
			{
				"env":
				{
					"CC": "gcc",
					"CXX": "g++"
				}
			},
			"config-opts":
			[
				"-DCMAKE_INSTALL_PREFIX=/app",
				"-DCMAKE_INSTALL_LIBDIR=lib",
				"-DCMAKE_BUILD_TYPE=Release"
			],
			"sources":
			[
				{
					"type": "archive",
					"url": "https://github.com/rui314/mold/archive/refs/tags/v2.42.1.tar.gz",
					"sha256": "0580221bfdad7148ceeafd0ad3c1c7b3ca9e66b45950405230cc3f81a205c816"
				}
			]
		},
    	{
			"name": "libc++",
			"buildsystem": "cmake-ninja",
			"subdir": "llvm",
			"builddir": true,
			"config-opts":
			[
				"-DCMAKE_INSTALL_PREFIX=/app",
				"-DCMAKE_INSTALL_LIBDIR=lib",
				"-DLLVM_TARGETS_TO_BUILD=X86",
				"-DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR=OFF",
				"-DLLVM_LIBDIR_SUFFIX=''",
				"-DCMAKE_BUILD_TYPE=Release",
				"-DLLVM_BUILD_32_BITS=OFF",
				"-DCOMPILER_RT_DEFAULT_TARGET_ONLY=ON",
				"-DLIBCXX_BUILD_32_BITS=OFF",
				"-DLLVM_ENABLE_PROJECTS=clang",
				"-DLLVM_ENABLE_RUNTIMES=compiler-rt;libunwind;libcxx;libcxxabi",
				"-DCLANG_DEFAULT_CXX_STDLIB=libc++",
				"-DCLANG_DEFAULT_RTLIB=compiler-rt",
				"-DCLANG_DEFAULT_UNWINDLIB=libunwind",
				"-DCLANG_DEFAULT_LINKER=mold",
				"-DLLVM_USE_LINKER=mold",
				"-DBUILD_SHARED_LIBS=ON"
			],
			"build-options":
			{
				"env":
				{
					"CC": "gcc",
					"CXX": "g++"
				}
			},
			"sources":
			[
				{
					"type": "git",
					"url": "https://github.com/llvm/llvm-project.git",
					"branch": "release/21.x"
				}
			]
		},
		{
			"name": "libsigcplusplus",
			"buildsystem": "meson",
			"config-opts": ["-Dbuild-tests=false"],
			"sources":
			[
				{
					"type": "archive",
					"url": "https://github.com/libsigcplusplus/libsigcplusplus/releases/download/3.8.1/libsigc++-3.8.1.tar.xz",
					"sha256": "4ff41d1474e501d3baeced4c989d154338206ac16471e614376496b63fe252d1"
				}
			]
		},/* end libsigcplusplus */
		{
			"name" : "gsound",
			"buildsystem" : "meson",
			"config-opts": ["-Denable_vala=false"],
			"sources" :
			[
				{
					"type" : "git",
					"url" : "https://gitlab.gnome.org/GNOME/gsound.git"
				}
			],
			"modules":
			[
				{
					"name": "libcanberra",
					"config-opts":
					[
						"--disable-alsa",
						"--disable-null",
						"--disable-oss",
						"--disable-gtk3"
					],
					"sources":
					[
						{
							"type": "archive",
							"url": "http://0pointer.de/lennart/projects/libcanberra/libcanberra-0.30.tar.xz",
							"sha256": "c2b671e67e0c288a69fc33dc1b6f1b534d07882c2aceed37004bf48c601afa72"
						}
					]
				}
			]
		},/* end gsound */
		{
			"name": "gtkmm",
			"buildsystem": "meson",
			"sources":
			[
				{
					"type": "git",
					"url": "https://gitlab.gnome.org/GNOME/gtkmm.git"
				}
			],
			"modules":
			[
				{
					"name": "cairomm",
					"buildsystem": "meson",
					"config-opts": ["-Dbuild-tests=false"],
					"sources":
					[
						{
							"type": "archive",
							"url": "https://gitlab.freedesktop.org/cairo/cairomm/-/archive/1.18.1/cairomm-1.18.1.tar.bz2",
							"sha256": "05de03caac448b038a4319c06a2081a595634d9826e3187e83fb837ef8cd29f7"
						}
					]
				},
				{			
					"name": "pangomm",
					"buildsystem": "meson",
					"sources":
					[
						{
							"type": "git",
							"url": "https://gitlab.gnome.org/GNOME/pangomm.git"
						}
					]
					,
					"modules":
					[
						{
							"name": "glibmm",
							"buildsystem": "meson",
	  						"sources":
	  						[
								{
									"type": "git",
									"url": "https://gitlab.gnome.org/GNOME/glibmm.git"
								}
							],
							"modules":
							[
								{
									"name": "mm-common",
									"buildsystem": "meson",
									"sources":
									[
										{
											"type": "archive",
											"url": "https://download.gnome.org/sources/mm-common/1.0/mm-common-1.0.8.tar.xz",
											"sha256": "b189ee636e839d12c00dabefae099fd488ab2358dec24d264761c011950b02a9"
										}
									]
								}
							]
						}
					]
				}
			]
		},/* end gtkmm */
		{
			"name": "itstool",
			"buildsystem": "autotools",
			"build-options":
			{
				"cflags": "-O2 -std=c99"
			},
			"config-opts":
			[
				"--prefix=/app"
			],
			"sources":
			[
				{
					"type": "git",
					"url": "https://github.com/itstool/itstool.git"
				}
			]
		},/* end itstool */
		{
			"name": "gnome-nibbles",
			"buildsystem": "meson",
			"config-opts":
			[
				"-Dappend_to_version= (GNOME flatpak libc++)",
				"-Dwebsite=https://gitlab.gnome.org/GNOME/gnome-nibbles"
			],
			"sources":
			[
				{
					"type": "git",
					"url": "https://gitlab.gnome.org/GNOME/gnome-nibbles.git"
				}                
			]
		}/* end gnome-nibbles */
	]
}
