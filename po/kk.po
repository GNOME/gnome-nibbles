#. Translators: command-line error message, displayed for an invalid start
#. level request; see 'gnome-nibbles -l 0'
#: src/nibbles.cpp:221
msgid "Start level must be between 1 and 26 inclusive."
msgstr "Бастапқы деңгей 1 мен 26 аралығында (қоса алғанда) болуы керек."

#. Translators: command-line error message, displayed for an invalid progress
#. method request; see 'gnome-nibbles --progress'
#: src/nibbles.cpp:251
msgid "Progress method should be; sequentially, randomly, or fixed board."
msgstr ""
"Прогресс әдісі келесілердің бірі болуы керек: sequentially, randomly немесе "
"fixed board."

#. Translators: command-line error message, displayed for an invalid progress
#. method request; see 'gnome-nibbles --progress'
#: src/nibbles.cpp:274
msgid ""
"Progress method should be; s for sequentially, r for randomly or f for fixed "
"board."
msgstr ""
"Прогресс әдісі келесідей болуы керек: sequentially үшін s, randomly үшін r "
"немесе fixed board үшін f."

#. Translators: command-line error message, displayed for an invalid progress
#. method request; see 'gnome-nibbles --progress'
#: src/nibbles.cpp:302 src/nibbles.cpp:309
msgid ""
"Progress method should be; 0 - sequentially, 1 - randomly or 2 - fixed board."
msgstr ""
"Прогресс әдісі келесідей болуы керек: 0 - рет-ретімен, 1 - кездейсоқ немесе 2 "
"- бекітілген тақта."

#. Translators: command-line error message, displayed for an invalid number of
#. players; see 'gnome-nibbles -p 5'
#: src/nibbles.cpp:322
msgid "Players must be between 1 and 4 inclusive."
msgstr "Ойыншылар саны 1 мен 4 аралығында (қоса алғанда) болуы керек."

#. Translators: command-line error message, displayed for an invalid number of
#. nibbles; see 'gnome-nibbles -n 0'
#: src/nibbles.cpp:335 src/nibbles.cpp:351
msgid "Nibbles must be between "
msgstr "Nibbles саны мына аралықта болуы керек: "

#: src/nibbles.cpp:335 src/nibbles.cpp:351
msgid " and 6 inclusive."
msgstr " және 6 қоса алғанда."

#. Translators: command-line error message, displayed for an invalid number of
#. players; see 'gnome-nibbles -s 5'
#: src/nibbles.cpp:364
msgid "Speed must be between 1(fast) and 4(beginner) inclusive."
msgstr ""
"Жылдамдық 1(жылдам) мен 4(жаңа бастаушы) аралығында (қоса алғанда) болуы "
"керек."

#. Translators: command-line error message, displayed for an invalid
#. combination of options; see 'gnome-nibbles -d -e'
#: src/nibbles.cpp:378
msgid ""
"Options --disable-fakes (-d) and --enable-fakes (-e) are mutually exclusive."
msgstr ""
"--disable-fakes (-d) және --enable-fakes (-e) опциялары бір-бірін жоққа "
"шығарады."

#. Translators: command-line error message, displayed for an invalid
#. combination of options; see 'gnome-nibbles --mute --unmute'
#: src/nibbles.cpp:401
msgid "Options --mute and --unmute are mutually exclusive."
msgstr "--mute және --unmute опциялары бір-бірін жоққа шығарады."

#. Translators: command-line error message, displayed for an invalid
#. combination of options; see 'gnome-nibbles -3 -2'
#: src/nibbles.cpp:422
msgid "Options --3D (-3) and --2D (-2) are mutually exclusive."
msgstr "--3D (-3) және --2D (-2) опциялары бір-бірін жоққа шығарады."

