#: src/nibbles.cpp:364
msgid "Speed must be between 1(fast) and 4(beginner) inclusive."
msgstr "Hastigheten ska vara från 1 (snabb) till 4 (nybörjare)."

#. Translators: command-line error message, displayed for an invalid combination of options; see 'gnome-nibbles -d -e'
#: src/nibbles.cpp:378
msgid ""
"Options --disable-fakes (-d) and --enable-fakes (-e) are mutually exclusive."
msgstr ""
"Flaggorna --disable-fakes (-d) och --enable-fakes (-e) är ömsesidigt "
"uteslutande."

#. Translators: command-line error message, displayed for an invalid combination of options; see 'gnome-nibbles --mute --unmute'
#: src/nibbles.cpp:401
msgid "Options --mute and --unmute are mutually exclusive."
msgstr "Flaggorna --mute och --unmute är ömsesidigt uteslutande."

#. Translators: command-line error message, displayed for an invalid combination of options; see 'gnome-nibbles -3 -2'
#: src/nibbles.cpp:422
