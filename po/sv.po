msgstr "Nivå 1 med 5 spelare"

#: data/org.gnome.Nibbles.metainfo.xml.in:38
msgid "Level 18 with 6 players"
msgstr "Nivå 18 med 6 spelare"

#: data/org.gnome.Nibbles.metainfo.xml.in:91
