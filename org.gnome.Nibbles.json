{
    "app-id": "org.gnome.Nibbles",
    "runtime": "org.gnome.Platform",
    "runtime-version": "master",
    "sdk": "org.gnome.Sdk",
    "command": "gnome-nibbles",
    "sdk-extensions": ["org.freedesktop.Sdk.Extension.llvm22"],
	"build-options":
	{
		"append-path": "/usr/lib/sdk/llvm22/bin",
		"prepend-ld-library-path": "/usr/lib/sdk/llvm22/lib",
		"env": {
		    "CC": "clang",
		    "CXX": "clang++"
		}
	},
	"finish-args": [
        /* X11 + XShm access */
        "--share=ipc", "--socket=fallback-x11",
        /* Wayland access */
        "--socket=wayland",
        /* Sound! */
        "--socket=pulseaudio",
        /* OpenGL access */
        "--device=dri"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "/share/vala",
        "*.la",
        "*.a"
    ],
    "modules":
    [
    	{
			"name": "lib++",
			"buildsystem": "simple",
			"build-commands":
			[
				"mkdir _flatpak_build",
				"cmake -G Ninja -S llvm -B _flatpak_build -DCMAKE_INSTALL_PREFIX=/app -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release -DLLVM_ENABLE_RUNTIMES='libunwind;libcxx;libcxxabi'",
				"ninja -C _flatpak_build unwind cxx cxxabi ",
				"ninja -C _flatpak_build install-unwind install-cxx install-cxxabi"
			],
			"sources":
			[
				{
					"type": "git",
					"url": "https://github.com/llvm/llvm-project.git",
					"depth": 1,
				    "branch": "main"
				}
			]
		},
		{
			"name": "libsigcplusplus",
			"buildsystem": "meson",
			"config-opts": ["-Dbuild-tests=false"],
			"sources":
			[
				{
					"type": "archive",
					"url": "https://github.com/libsigcplusplus/libsigcplusplus/releases/download/3.8.1/libsigc++-3.8.1.tar.xz",
					"sha256": "4ff41d1474e501d3baeced4c989d154338206ac16471e614376496b63fe252d1"
				}
			]
		},
        {
            "name" : "gsound",
            "buildsystem" : "meson",
            "sources" :
            [
                {
                    "type" : "git",
                    "url" : "https://gitlab.gnome.org/GNOME/gsound.git"
                }
            ],
            "modules":
            [
                {
                    "name": "libcanberra",
                    "config-opts":
                    [
                        "--disable-alsa",
                        "--disable-null",
                        "--disable-oss",
                        "--disable-gtk3"
                    ],
                    "sources":
                	[
                		{
							"type": "archive",
							"url": "http://0pointer.de/lennart/projects/libcanberra/libcanberra-0.30.tar.xz",
							"sha256": "c2b671e67e0c288a69fc33dc1b6f1b534d07882c2aceed37004bf48c601afa72"
                    	}
                    ]
                }
            ]
        },
		{
			"name": "gtkmm",
			"buildsystem": "meson",
			"sources":
			[
				{
					"type": "git",
					"url": "https://gitlab.gnome.org/GNOME/gtkmm.git"
				}
			],
			"modules":
			[
				{
					"name": "cairomm",
					"buildsystem": "meson",
					"config-opts": ["-Dbuild-tests=false"],
					"sources":
					[
						{
							"type": "archive",
							"url": "https://gitlab.freedesktop.org/cairo/cairomm/-/archive/1.18.1/cairomm-1.18.1.tar.bz2",
							"sha256": "05de03caac448b038a4319c06a2081a595634d9826e3187e83fb837ef8cd29f7"
						}
					]
				},
				{			
					"name": "pangomm",
					"buildsystem": "meson",
					"sources":
					[
						{
							"type": "git",
							"url": "https://gitlab.gnome.org/GNOME/pangomm.git"
						}
					]
					,
					"modules":
					[
						{
							"name": "glibmm",
							"buildsystem": "meson",
	  						"sources":
	  						[
								{
									"type": "git",
									"url": "https://gitlab.gnome.org/GNOME/glibmm.git"
								}
							],
							"modules":
							[
								{
									"name": "mm-common",
									"buildsystem": "meson",
									"sources":
									[
										{
											"type": "archive",
											"url": "https://download.gnome.org/sources/mm-common/1.0/mm-common-1.0.8.tar.xz",
											"sha256": "b189ee636e839d12c00dabefae099fd488ab2358dec24d264761c011950b02a9"
										}
									]
								}
							]
						}
					]
				}
			]
		},        
        {
            "name": "gnome-nibbles",
            "buildsystem": "meson",
			"config-opts":
			[
                "-Dappend_to_version= (GNOME flatpak)",
                "-Dwebsite=https://gitlab.gnome.org/GNOME/gnome-nibbles"
            ],
            "sources":
            [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/gnome-nibbles.git"
                }                
            ]
        }
    ]
}
